# Fast default: same 27B family, IQ3 quantization, native MTP, all layers on GPU.
# One active request / 8K context. Multiple agents can queue on the same API.
API_PORT=8001
MODEL_ALIAS=huihui-qwen3.8-27b
MODEL_FILE=huihui-27b-iq3_xxs.gguf
GPU_LAYERS=99
CPU_THREADS=8
TOTAL_CONTEXT=8192
CONTEXT_PER_SLOT=8192
PARALLEL_SLOTS=1
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
SPEC_TYPE=draft-mtp
SPEC_DRAFT_MAX=3
UBATCH_SIZE=64
